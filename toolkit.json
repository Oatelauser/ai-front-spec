{
  "schemaVersion": 3,
  "kind": "frontend-project-starter",
  "name": "ai-front-spec",
  "version": "6.1.1",
  "starter": {
    "runtime": ["AGENTS.md", "CLAUDE.md", "README.md", "docs", ".agents", ".claude", ".toolkit", "LICENSE", "NOTICE"]
  },
  "distExcludes": ["scripts", "toolkit.json", "docs/wayfinder", ".serena", "CONTRIBUTING.md", ".git", ".github", ".gitignore", ".gitattributes"],
  "skipIfExists": [
    ".toolkit/manifest.json",
    ".toolkit/profile-state.json",
    "docs/PROJECT_PROFILE.md",
    "docs/rules/FRONTEND_CONVENTIONS.md",
    "docs/rules/AI_COMPONENT_CATALOG.md",
    "docs/rules/AI_FRONTEND_TASK.md",
    "docs/rules/AI_TASK_CONTRACT.md",
    "docs/rules/AI_PROJECT_STANDARDS.md",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md"
  ],
  "profiles": {
    "generic": ".agents/skills/project-profile/templates/project-profile.generic.md",
    "react": ".agents/skills/project-profile/templates/project-profile.react.md",
    "vue": ".agents/skills/project-profile/templates/project-profile.vue.md"
  },
  "profileTarget": "docs/PROJECT_PROFILE.md",
  "internal": {
    "build": "scripts/build-starter.mjs",
    "scripts": "scripts",
    "tests": "scripts/lib",
    "manifest": "toolkit.json"
  },
  "skills": [
    "project-workflow",
    "project-profile",
    "frontend-task",
    "mobile-ux-optimizer",
    "apple-design",
    "gsap-core",
    "gsap-performance",
    "gsap-timeline",
    "tinypng-compress",
    "playwright",
    "compatibility-testing",
    "karpathy-guidelines",
    "api-design",
    "frontend-design",
    "frontend-design-direction",
    "grill-me",
    "grilling",
    "product-design",
    "prototype",
    "react-best-practices",
    "security-review",
    "taste-skill",
    "tdd-workflow",
    "web-design-guidelines"
  ]
}
